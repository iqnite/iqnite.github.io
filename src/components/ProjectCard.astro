---
import "../styles/style.css";
import "../styles/home.css";
import { Image } from "astro:assets";

const {
  title,
  description,
  image,
  titleLink,
  buttonText,
  buttonLink,
  category,
} = Astro.props;
---

<div class="project-card vertical-banner" data-category={category}>
  <Image src={image} alt={title} class="project-img" />
  <div>
    <h3>
      <a href={titleLink}>{title}</a>
    </h3>
    <p set:html={description} />{" "}
    <a class="link-button" href={buttonLink}>{buttonText}</a>{" "}
    <slot />
  </div>
</div>
