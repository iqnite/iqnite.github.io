---
import "../styles/style.css";
import "../styles/home.css";
---

<header aria-label="Header">
  <div class="header-item">
    <a class="side-by-side header-main-link" href="https://iqnite.github.io">
      <img
        class="header-img header-logo"
        src="images/logo_transparent.webp"
        alt=""
      /><span id="header-title"> phorb.dev</span>
    </a>
  </div>
  <div class="separator"></div>
  <div class="side-by-side header-item header-links">
    <div class="row">
      <a class="row-item" href="https://github.com/iqnite" title="GitHub">
        <img class="header-img" src="images/github.svg" alt="GitHub" /></a
      >{" "}
      <a class="row-item" href="https://slashlab.itch.io" title="itch.io">
        <img class="header-img" src="images/itchio.svg" alt="itch.io" /></a
      >{" "}
      <a
        class="row-item"
        href="https://scratch.mit.edu/users/philipp2007"
        title="Scratch"
      >
        <img class="header-img" src="images/scratch.svg" alt="Scratch" /></a
      >
    </div>
  </div>
</header>
