---
import "../styles/style.css";
import "../styles/home.css";
import HeaderLinkRow from "./HeaderLinkRow.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent.svg";
---

<header aria-label="Header">
  <div class="header-item">
    <a class="side-by-side header-main-link" href="https://iqnite.github.io">
      <Image
        class="header-img header-logo"
        src={logo}
        alt=""
        loading="eager"
      /><span id="header-title"> phorb.dev</span>
    </a>
  </div>
  <div class="separator"></div>
  <div class="side-by-side header-item header-links">
    <HeaderLinkRow />
  </div>
</header>
