---
import "../styles/style.css";
import { Image } from "astro:assets";
import errorImage from "../assets/404.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <title>Page Not Found | phorb.dev</title>
  </head>
  <body>
    <h1>404 - Page Not Found</h1>
    <p>
      We're sorry, but the page you are looking for cannot be found. It may have
      been moved, deleted, or never existed in the first place. Check the
      address for typos, or return to the{" "}<a href="/">home page</a>{" "}to
      continue browsing.
    </p>
    <p>
      <Image src={errorImage} alt="404" loading="eager" />
    </p>
  </body>
</html>

