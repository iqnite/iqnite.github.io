---
import "../styles/style.css";
import "../styles/home.css";
import MainHeader from "../components/MainHeader.astro";
import CategoryBar from "../components/CategoryBar.astro";
import ProjectLayout from "../components/ProjectLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HeaderLinkRow from "../components/HeaderLinkRow.astro";
import { Image } from "astro:assets";
import bmcLogo from "../assets/bmc-logo.webp";
import githubLogo from "../assets/github.svg";
import scratchLogo from "../assets/scratch.svg";
import youtubeLogo from "../assets/youtube.svg";
import autocubeBanner from "../assets/autocube.webp";
import bitrunBanner from "../assets/bitrun_logo_shift.webp";
import eggsplodeBanner from "../assets/eggsplode_banner.webp";
import msixNoCertBanner from "../assets/msix-no-cert-banner.webp";
import pyspecBanner from "../assets/pyspec.webp";
import rbnPalBanner from "../assets/rbn-pal.webp";
import scratchOSXBanner from "../assets/scratchos-x-cover.webp";
import spaceChaosBanner from "../assets/space_chaos_logo.webp";
import spamojiBanner from "../assets/spamojifactorial.webp";
import ufoSgrognoxBanner from "../assets/ufo_sgrognox_logo.webp";
import vingramBanner from "../assets/vingram.webp";
import wyderBanner from "../assets/wyder-screenshot.webp";
import yeetmeBanner from "../assets/yeetme-banner.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>phorb.dev</title>
    <meta
      name="description"
      content="Fun games and useful tools for every imaginable problem, made by a high schooler."
    />
    <link rel="icon" href="images/logo_transparent.webp" type="image/webp" />
    <meta property="og:title" content="phorb.dev" />
    <meta
      property="og:description"
      content="Fun games and useful tools for every imaginable problem, made by a high schooler."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iqnite.github.io/" />
    <meta
      property="og:image"
      content="https://iqnite.github.io/images/material_logo.png"
    />
  </head>

  <body>
    <MainHeader />
    <main aria-label="Main content">
      <h1>
        <img
          class="color-change"
          src="images/leddy.webp"
          width="25px"
          alt=""
        />{" "}
        Hi, I'm Philipp!
      </h1>
      <p>
        I'm a student in IT and engineering who likes to make apps and games and
        tinker around with Raspberry Pi and electronics.
      </p>
      <p>
        <strong class="green">Like my work?</strong>{" "}
        <a class="link-button" href="https://buymeacoffee.com/phorb"
          ><Image
            src={bmcLogo}
            width="25"
            alt="Buy me a coffee logo"
            loading="eager"
          />{" "}Buy me a coffee</a
        >
      </p>

      <p class="green">
        <strong>Scroll down to see some of my creations!</strong>
      </p>
      <CategoryBar />
      <ProjectLayout>
        <ProjectCard
          image={eggsplodeBanner}
          titleLink="eggsplode"
          title="Eggsplode"
          description="
              The Discord adaptation of the Exploding Kittens card game! During
              your turn, you draw a card. If it's an Eggsplode card, you lose!
              Use all the other cards to attack, steal, defuse, survive, and
              win!"
          buttonLink="eggsplode/install.html"
          buttonText="Install"
          category="Games"
        >
          <a href="eggsplode/github.html"
            ><Image
              src={githubLogo}
              title="GitHub"
              alt="GitHub"
              width="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={wyderBanner}
          titleLink="wyder"
          title="Wyder"
          description="
          An intuitive and powerful video downloader for Windows with no ads
          and no scams that allows you to download videos from various
          platforms, including YouTube, Spotify, TikTok, and many more, for
          free."
          buttonLink="https://apps.microsoft.com/detail/9N5XN62FZ62R"
          buttonText="Download"
          category="Apps"
        >
          <a href="https://github.com/iqnite/yt-dlp-ui"
            ><Image
              src={githubLogo}
              title="GitHub"
              alt="GitHub"
              width="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={spaceChaosBanner}
          titleLink="https://scratch.mit.edu/projects/510859688/"
          title="Space Chaos"
          description="Fly through space, eating rainbow tacos and dodging asteroids. It
              also has UFOs and a Nyan cat!"
          buttonLink="https://scratch.mit.edu/projects/510859688/"
          buttonText="Play"
          category="Games"
        >
          <a href="https://youtu.be/Kzafrox2QRk"
            ><Image
              src={youtubeLogo}
              title="YouTube trailer"
              alt="YouTube"
              height="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={bitrunBanner}
          titleLink="bitrun"
          title="bitrun"
          description="Fight enemies, jump over electric floors, dodge blades… oh, and by
        the way, save the world."
          buttonLink="bitrun"
          buttonText="Play"
          category="Games"
        >
          <a href="https://scratch.mit.edu/projects/894848098/"
            ><Image
              src={scratchLogo}
              title="Scratch"
              alt="Scratch"
              height="25"
            /></a
          >{" "}
          <a href="https://youtu.be/_cRHvoG_YGY"
            ><Image
              src={youtubeLogo}
              title="YouTube trailer"
              alt="YouTube"
              height="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={pyspecBanner}
          titleLink="https://www.astrolens.net/downloads"
          title="pySPEC"
          description="
            A platform-independent app for spectroscopy with the TCD1304.
            Developed in collaboration with
            <a href='https://www.astrolens.net/'>AstroLens</a>."
          buttonLink="https://www.astrolens.net/downloads"
          buttonText="Download"
          category="Apps"
        >
          <a href="https://github.com/iqnite/pyccd-spectrometer"
            ><Image
              src={githubLogo}
              title="GitHub"
              alt="GitHub"
              height="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={msixNoCertBanner}
          titleLink="https://github.com/iqnite/msix-no-cert"
          title="Self-signed MSIX"
          description="
          Allows creating installers for MSIX files with a self-signed
          certificate."
          buttonLink="https://www.powershellgallery.com/packages/msix-no-cert"
          buttonText="Install"
          category="Apps"
        />
        <ProjectCard
          image={spamojiBanner}
          titleLink="https://github.com/iqnite/spamoji"
          title="Spamoji 🍝"
          description="
            A programming language that only uses emojis as syntax and
            encourages writing spaghetti code."
          buttonLink="https://github.com/iqnite/spamoji"
          buttonText="Learn more"
          category="Concepts"
        />
        <ProjectCard
          image={autocubeBanner}
          titleLink="https://github.com/iqnite/autocube"
          title="Autocube"
          description="
            A 3x3x3 Rubik's cube solver that can either find solutions from a JSON representation 
            or perform algorithms on a physical cube via a LEGO Mindstorms EV3 robot."
          buttonLink="https://youtu.be/EfhrIaZWvno"
          buttonText="Watch Demo"
          category="Concepts"
        />
        <ProjectCard
          image={vingramBanner}
          titleLink="https://github.com/iqnite/vingram"
          title="Vingram"
          description="
            A web-based diagramming tool that allows you to create diagrams with
            the hand-drawn aesthetic from old science textbooks."
          buttonLink="https://iqnite.github.io/vingram"
          buttonText="Try it"
          category="Apps"
        />
        <ProjectCard
          image={scratchOSXBanner}
          titleLink="scratchos"
          title="ScratchOS X"
          description="
            An operating system made entirely in Scratch."
          buttonLink="https://scratch.mit.edu/projects/365039244"
          buttonText="Try it"
          category="Concepts"
        >
          <a href="scratchos/changelog/">Change log</a>
        </ProjectCard>
        <ProjectCard
          image={ufoSgrognoxBanner}
          titleLink="https://slashlab.itch.io/sgrognox"
          title="UFO Sgrognox"
          description="Fly through space, steal cars, and dodge comets, helicopters, other UFOs..."
          buttonLink="https://slashlab.itch.io/sgrognox"
          buttonText="Play"
          category="Games"
        >
          <a href="https://github.com/iqnite/sgrognox"
            ><Image
              src={githubLogo}
              title="GitHub"
              alt="GitHub"
              height="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image={yeetmeBanner}
          titleLink="https://github.com/iqnite/MotionSound"
          title="Yeetme!"
          description="
            Makes wacky sounds when you move your phone in specific ways. It has
            multiple modes, such as Gun, Bomb, Speed, and more."
          buttonLink="https://github.com/iqnite/MotionSound/releases/latest"
          buttonText="Download"
          category="Games"
        />
        <ProjectCard
          image={rbnPalBanner}
          titleLink="https://github.com/iqnite/rbn-pal"
          title="RBN Pal"
          description="
            A browser extension that enhances the user experience on the Reverse Beacon Network."
          buttonLink="https://github.com/iqnite/rbn-pal#installation"
          buttonText="Install"
          category="Apps"
        />
      </ProjectLayout>

      <p>
        <img
          class="color-change"
          src="images/leddy.webp"
          width="100px"
          alt=""
          loading="lazy"
        />
      </p>
      <h1>Want to see more?</h1>
      <div class="header-item side-by-side">
        <HeaderLinkRow loading="lazy" />
      </div>
    </main>
    <footer aria-label="Footer">
      <p>
        <a id="lastSiteUpdate" href="https://github.com/iqnite/iqnite.github.io"
          >View on GitHub</a
        >
      </p>
      <p>2020 - 2026 with ❤️ by phorb.dev</p>
      <br />
      <br />
      <br />
    </footer>
    <script src="../scripts/categories.ts"></script>
    <script src="../scripts/headerScroll.ts"></script>
    <script src="../scripts/lastUpdate.ts"></script>
  </body>
</html>
