---
import "../styles/style.css";
import "../styles/home.css";
import ProjectCard from "../components/ProjectCard.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>phorb.dev</title>
    <meta
      name="description"
      content="Fun games and useful tools for every imaginable problem, made by a high schooler."
    />
    <link rel="icon" href="images/logo_transparent.webp" type="image/webp" />
    <meta property="og:title" content="phorb.dev" />
    <meta
      property="og:description"
      content="Fun games and useful tools for every imaginable problem, made by a high schooler."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iqnite.github.io/" />
    <meta
      property="og:image"
      content="https://iqnite.github.io/images/material_logo.png"
    />
  </head>

  <body>
    <header aria-label="Header">
      <div class="header-item">
        <a
          class="side-by-side header-main-link"
          href="https://iqnite.github.io"
        >
          <img
            class="header-img header-logo"
            src="images/logo_transparent.webp"
            alt=""
          /><span id="header-title"> phorb.dev</span>
        </a>
      </div>
      <div class="separator"></div>
      <div class="side-by-side header-item header-links">
        <div class="row">
          <a class="row-item" href="https://github.com/iqnite" title="GitHub">
            <img class="header-img" src="images/github.svg" alt="GitHub" /></a
          >{" "}
          <a class="row-item" href="https://slashlab.itch.io" title="itch.io">
            <img class="header-img" src="images/itchio.svg" alt="itch.io" /></a
          >{" "}
          <a
            class="row-item"
            href="https://scratch.mit.edu/users/philipp2007"
            title="Scratch"
          >
            <img class="header-img" src="images/scratch.svg" alt="Scratch" /></a
          >
        </div>
      </div>
    </header>
    <main aria-label="Main content">
      <h1>
        <img
          class="color-change"
          src="images/leddy.webp"
          width="25px"
          alt=""
        />{" "}
        Hi, I'm Philipp!
      </h1>
      <p>
        I'm a student in IT and engineering who likes to make apps and games and
        tinker around with Raspberry Pi and electronics.
      </p>
      <p class="green">
        <strong>Scroll down to see some of my creations!</strong>
      </p>
      <p>
        <strong class="green">Like my work?</strong>{" "}
        <a class="link-button" href="https://buymeacoffee.com/phorb"
          ><img
            src="images/bmc-logo.webp"
            width="25"
            alt="Buy me a coffee logo"
          />{" "}Buy me a coffee</a
        >
      </p>
      <h2>Games</h2>
      <div class="side-by-side">
        <ProjectCard
          image="images/eggsplode_banner.webp"
          titleLink="eggsplode"
          title="Eggsplode"
          description="
              The Discord adaptation of the Exploding Kittens card game! During
              your turn, you draw a card. If it's an Eggsplode card, you lose!
              Use all the other cards to attack, steal, defuse, survive, and
              win!"
          buttonLink="eggsplode/install.html"
          buttonText="Install"
        >
          <a href="eggsplode/github.html"
            ><img src="images/github.svg" title="GitHub" width="25" /></a
          >
        </ProjectCard>
        <ProjectCard
          image="images/space_chaos_logo.webp"
          titleLink="https://scratch.mit.edu/projects/510859688/"
          title="Space Chaos"
          description="Fly through space, eating rainbow tacos and dodging asteroids. It
              also has UFOs and a Nyan cat!"
          buttonLink="https://scratch.mit.edu/projects/510859688/"
          buttonText="Play"
        >
          <a href="https://youtu.be/Kzafrox2QRk"
            ><img
              src="images/youtube.svg"
              title="YouTube trailer"
              height="25"
            /></a
          >
        </ProjectCard>
        <ProjectCard
          image="images/bitrun_logo_shift.webp"
          titleLink="bitrun"
          title="bitrun"
          description="Fight enemies, jump over electric floors, dodge blades… oh, and by
        the way, save the world."
          buttonLink="bitrun"
          buttonText="Play"
        >
          <a href="https://scratch.mit.edu/projects/894848098/"
            ><img src="images/scratch.svg" title="Scratch" height="25" /></a
          >{" "}
          <a href="https://youtu.be/_cRHvoG_YGY"
            ><img
              src="images/youtube.svg"
              title="YouTube trailer"
              height="25"
            /></a
          >
        </ProjectCard>
      </div>
      <h2>Utilities</h2>
      <div class="side-by-side">
        <ProjectCard
          image="images/wyder-screenshot.webp"
          titleLink="wyder"
          title="Wyder"
          description="
          An intuitive and powerful video downloader for Windows with no ads
          and no scams that allows you to download videos from various
          platforms, including YouTube, Spotify, TikTok, and many more, for
          free."
          buttonLink="https://apps.microsoft.com/detail/9N5XN62FZ62R"
          buttonText="Download"
        >
          <a href="https://github.com/iqnite/yt-dlp-ui"
            ><img src="images/github.svg" title="GitHub" width="25" /></a
          >
        </ProjectCard>
        <ProjectCard
          image="images/pyspec.webp"
          titleLink="https://www.astrolens.net/downloads"
          title="pySPEC"
          description="
            A platform-independent app for spectroscopy with the TCD1304.
            Developed in collaboration with
            <a href='https://www.astrolens.net/'>AstroLens</a>."
          buttonLink="https://www.astrolens.net/downloads"
          buttonText="Download"
        >
          <a href="https://github.com/iqnite/pyccd-spectrometer"
            ><img src="images/github.svg" title="GitHub" height="25" /></a
          >
        </ProjectCard>
        <ProjectCard
          image="images/msix-no-cert-banner.webp"
          titleLink="https://github.com/iqnite/msix-no-cert"
          title="Self-signed MSIX"
          description="
          Allows creating installers for MSIX files with a self-signed
          certificate."
          buttonLink="https://www.powershellgallery.com/packages/msix-no-cert"
          buttonText="Install"
        />
      </div>
      <h2>Fun Stuff</h2>
      <div class="side-by-side">
        <ProjectCard
          image="images/spamojifactorial.webp"
          titleLink="https://github.com/iqnite/spamoji"
          title="Spamoji 🍝"
          description="
            A programming language that only uses emojis as syntax and
            encourages writing spaghetti code."
          buttonLink="https://github.com/iqnite/spamoji"
          buttonText="Learn more"
        />
        <ProjectCard
          image="images/scratchos-x-cover.webp"
          titleLink="scratchos"
          title="ScratchOS X"
          description="
            An operating system made entirely in Scratch."
          buttonLink="https://scratch.mit.edu/projects/365039244"
          buttonText="Try it"
        >
          <a href="scratchos/changelog/">Change log</a>
        </ProjectCard>
        <ProjectCard
          image="images/yeetme_logo.webp"
          titleLink="https://github.com/iqnite/MotionSound"
          title="Yeetme!"
          description="
            Makes wacky sounds when you move your phone in specific ways. It has
            multiple modes, such as Gun, Bomb, Speed, and more."
          buttonLink="https://github.com/iqnite/MotionSound/releases/latest"
          buttonText="Download"
        />
      </div>
      <p>
        <img
          class="color-change"
          src="images/leddy.webp"
          width="100px"
          alt=""
        />
      </p>
      <h1>Want to see more?</h1>
      <div class="header-item side-by-side">
        <div class="row">
          <a class="row-item" href="https://github.com/iqnite" title="GitHub">
            <img class="header-img" src="images/github.svg" alt="GitHub" /></a
          >{" "}
          <a class="row-item" href="https://slashlab.itch.io" title="itch.io">
            <img class="header-img" src="images/itchio.svg" alt="itch.io" /></a
          >{" "}
          <a
            class="row-item"
            href="https://scratch.mit.edu/users/philipp2007"
            title="Scratch"
          >
            <img class="header-img" src="images/scratch.svg" alt="Scratch" /></a
          >
        </div>
      </div>
    </main>
    <footer>
      <p>
        <a id="lastSiteUpdate" href="https://github.com/iqnite/iqnite.github.io"
          >View on GitHub</a
        >
      </p>
      <p>2020 - 2026 with ❤️ by phorb.dev</p>
      <br />
      <br />
      <br />
    </footer>
    <script src="../scripts/index.ts"></script>
  </body>
</html>
